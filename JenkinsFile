pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out code from Git repository...'
                git branch: 'RouaOnsTousli', url: 'https://github.com/nada-elouedi/5artic5_G2_Kaddem.git'
            }

        }

        stage('Maven Clean') {
            steps {
                echo 'Running Maven clean...'
                sh 'mvn clean' // Use 'sh' if you're on a Unix-like system
            }
        }

        stage('Maven Compile') {
            steps {
                echo 'Running Maven compile...'
                sh 'mvn compile'
            }
        }

        stage('Maven Package') {
            steps {
                echo 'Running Maven compile...'
                sh 'mvn package'
            }
        }

        stage('Maven Test') {
            steps {
                echo 'Running Maven compile...'
                sh 'mvn test'
            }
        }



        // stage('MVN SonarQube') {
        //     steps {
        //         echo 'Running SonarQube analysis...'
        //         sh 'curl http://localhost:9000/'
        //         sh 'mvn sonar:sonar -Dsonar.host.url=http://localhost:9000/ -Dsonar.login=admin -Dsonar.password=sonarSONAR123*'
        //     }
        // }

        // stage('Deploy to Nexus') {
        //     steps {
        //         echo 'Deploying to Nexus...'
        //         sh 'mvn deploy -DskipTests'
        //         echo 'Deployment to Nexus completed'
        //     }
        // }

        stage('Docker Build') {
            steps {
                echo 'Building Docker image...'
                sh 'mvn clean package'
                // Build the Docker image using the correct path to your project
                sh 'docker build -t rouaons/myprojectkaddem:latest .'
            }
        }

        stage('Push Docker Image to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
                    script {
                        def imageName = "rouaons/myprojectkaddem:latest" // Use your actual repository name
                        echo 'Logging in to Docker Hub...'
                        sh "echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin"

                        echo 'Pushing Docker image to Docker Hub...'
                        sh "docker push ${imageName}"

                        echo 'Docker image pushed to Docker Hub successfully!'
                    } // Close the script block
                } // Close the withCredentials block
            }
        }

    }
}